doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title @plotdb/esh — embeddable shell runtime
    link(rel="stylesheet", href="/assets/esh/esh-term.iife.css")
    style(type="text/css"): :stylus
      html, body
        height 100%
        margin 0
        background #11111b
        font-family monospace
      #term
        height 100%
        padding 8px
        box-sizing border-box
      #test-btn
        position fixed
        top 12px
        right 16px
        z-index 10
        background #313244
        color #cdd6f4
        border 1px solid #45475a
        border-radius 6px
        padding .35rem .8rem
        font-family monospace
        cursor pointer
        &:hover
          background #45475a
      dialog#test-dlg
        background #1e1e2e
        color #cdd6f4
        border 1px solid #45475a
        border-radius 8px
        font-family monospace
        min-width 34rem
        max-width 44rem
        &::backdrop
          background rgba(0,0,0,.55)
        .case
          margin .4rem 0
          padding .35rem .6rem
          background #313244
          border-radius 6px
        .cmd
          color #89b4fa
        .out
          white-space pre-wrap
        .pass
          color #a6e3a1
        .fail
          color #f38ba8
        form
          margin-top .8rem
          text-align right
          button
            background #45475a
            color #cdd6f4
            border none
            border-radius 6px
            padding .3rem .9rem
            font-family monospace
            cursor pointer
  body
    #term
    button#test-btn tests
    dialog#test-dlg
      #summary
      #cases
      form(method="dialog"): button close
    script(src="/assets/esh/esh.iife.js")
    script(src="/assets/esh/esh-term.iife.js")
    script: :lsc
      # 主畫面: 終端 (worker + OPFS, worker url 由 esh-term 同目錄自動解析)
      esh-term.create-terminal document.get-element-by-id('term'), {}

      # tests popup: 另建獨立的 main-thread shell (InMemory), 不動終端的 fs
      cases =
        * 'ls', 'README.md\nnums.txt\nsrc'
        * 'cat README.md | grep needle', 'find the needle here'
        * 'sort -n nums.txt | head -n 2', '2\n4'
        * 'i=0; while [ $i -lt 3 ]; do echo $i; i=$((i+1)); done', '0\n1\n2'
        * 'greet() { echo hi $1; }; greet pug', 'hi pug'

      run-tests = (sh) ->
        fs = esh.fs
        fs.mkdir-sync '/home/web/src', {+recursive}
        fs.write-file-sync '/home/web/README.md', '# demo\nfind the needle here\n'
        fs.write-file-sync '/home/web/src/a.js', 'console.log("needle");\n'
        fs.write-file-sync '/home/web/nums.txt', '10\n2\n33\n4\n'
        sh.run 'cd /home/web'
        root = document.get-element-by-id 'cases'
        root.inner-HTML = ''
        passed = 0
        for [cmd, want] in cases
          r = sh.run cmd
          got = (r.stdout or '').replace /\n+$/, ''
          ok = got is want
          passed += 1 if ok
          d = document.create-element 'div'
          d.class-name = 'case'
          d.inner-HTML = '<span class="' + (if ok then 'pass">✔' else 'fail">✘') + '</span> <span class="cmd"></span><div class="out"></div>'
          d.query-selector '.cmd' .text-content = ' $ ' + cmd
          d.query-selector '.out' .text-content = if ok then got else 'got: ' + got + '\nwant: ' + want
          root.append-child d
        document.get-element-by-id 'summary' .text-content = passed + ' / ' + cases.length + ' passed'

      test-sh = null
      document.get-element-by-id 'test-btn' .add-event-listener 'click', ->
        p = if test-sh then Promise.resolve test-sh else esh.create-shell!.then -> test-sh := it
        p.then (sh) ->
          run-tests sh
          document.get-element-by-id 'test-dlg' .show-modal!
