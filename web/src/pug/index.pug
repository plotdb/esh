doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title @plotdb/esh — embeddable shell runtime
    style(type="text/css"): :stylus
      html, body
        margin 0
        min-height 100%
        background #11111b
        color #cdd6f4
        font-family monospace
      main
        max-width 42rem
        margin 0 auto
        padding 3rem 1.5rem
      h1
        font-size 1.4rem
        margin 0 0 .4rem
      p.brief
        color #a6adc8
        margin 0 0 2rem
      a.demo
        display block
        padding .9rem 1.1rem
        margin .8rem 0
        background #313244
        border 1px solid #45475a
        border-radius 8px
        color #cdd6f4
        text-decoration none
        &:hover
          background #45475a
        b
          color #89b4fa
        span
          display block
          margin-top .25rem
          color #a6adc8
          font-size .85rem
  body
    main
      h1 @plotdb/esh
      p.brief embeddable shell runtime — POSIX-ish shell + virtual fs, in the browser (worker + OPFS) or Node.
      a.demo(href="/terminal/")
        b terminal/
        span xterm terminal with the built-in worker (OPFS persistent) + a popup test suite
      a.demo(href="/custom/")
        b custom/
        span consumer-authored worker: registerCommand (async `ask` via hostcall dialog) + git pack — try: ask how many?, git init
